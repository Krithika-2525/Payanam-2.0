# Standalone API: app.planning.main:app. Never commit real credentials.
PAYANAM_BILLING_MODE=free_only
PAYANAM_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Optional until the user selects the Supabase project. Use a LIMITED runtime
# PostgreSQL login granted payanam_app; superuser/bypass-RLS login is rejected.
DATABASE_URL=
# Migration-only administrative connection, never place in frontend settings.
PAYANAM_MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# JWT issuer defaults to SUPABASE_URL/auth/v1; asymmetric signing keys required.
PAYANAM_AUTH_ISSUER=
PAYANAM_AUTH_AUDIENCE=authenticated
GEOAPIFY_API_KEY=
# Enable only after the provider account's no-overage/free-only controls are checked.
GEOAPIFY_ZERO_BILLING_CONFIRMED=false
PAYANAM_DAILY_CREDITS=2400
# Keep the existing deployment secret; generate securely for a NEW production API.
PAYANAM_PLAN_SECRET=
# Frontend public setting: explicit actual API origin, no trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8010

# Optional road geometry; leave blank/false for the user's no-key hackathon mode.
OPENROUTESERVICE_API_KEY=
ORS_ZERO_BILLING_CONFIRMED=false
