FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 APP_ENV=production
WORKDIR /app
COPY requirements-planning.txt .
RUN pip install --no-cache-dir -r requirements-planning.txt
COPY app/__init__.py app/__init__.py
COPY app/planning app/planning
RUN useradd --create-home payanam
USER payanam
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn app.planning.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
